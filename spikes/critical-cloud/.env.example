# Spike S1 — Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_PROFILE=agrosbo-role
# MAX_ITERATIONS=10
# TIMEOUT_MS=30000

# Spike S2 — Transcribe
# (uses AWS_REGION above)

# Spike S3 — SES
SES_SENDER_EMAIL=operator@example.com
SES_RECIPIENT_EMAIL=success@simulator.amazonses.com

# Spike S4 — Token (local only)
# Dedicated spike container: agrosbo-spike-token-db on port 54322
# DO NOT use agrosbo-local-db (port 54321)
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/agrosbo_spike_token

# AWS Credentials (temporary, from assumed role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
