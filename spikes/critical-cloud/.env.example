# Spike S1 — Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_PROFILE=agrosbo-role
# MAX_ITERATIONS=10
# TIMEOUT_MS=30000

# Spike S2 -- Transcribe
# (uses AWS_REGION and AWS_PROFILE above)
TRANSCRIBE_LANGUAGE_CANDIDATES=es-US,es-ES,es-MX
TRANSCRIBE_TIMEOUT_MS=30000
TRANSCRIBE_DRY_RUN=true

# Spike S3 -- SES Events (SES -> EventBridge -> SQS)
# (uses AWS_REGION and AWS_PROFILE above)
SES_DRY_RUN=true
SES_TIMEOUT_MS=30000
SES_CONFIGURATION_SET=agrosbo-spike-ses-config-20260727
EVENTBRIDGE_RULE_NAME=agrosbo-spike-ses-rule-20260727
SQS_QUEUE_NAME=agrosbo-spike-ses-events-20260727
SES_TEST_SENDER_EMAIL=verified-sender@example.invalid
SES_TEST_RECIPIENT=success@simulator.amazonses.com

# Spike S4 — Token (local only)
# Dedicated spike container: agrosbo-spike-token-db on port 54322
# DO NOT use agrosbo-local-db (port 54321)
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/agrosbo_spike_token

# AWS Credentials (temporary, from assumed role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
