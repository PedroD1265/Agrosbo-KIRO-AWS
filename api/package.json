{
  "name": "@agrosbo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore \"../web/**\" --ignore \"dist/**\" src/server.ts",
    "build": "tsc -b",
    "clean": "node ../scripts/clean.mjs api",
    "test:integration": "vitest run --config ../vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/scripts/seed-db.ts"
  },
  "dependencies": {
    "@agrosbo/shared": "*",
    "@aws-sdk/client-rds-data": "^3.600.0",
    "@vendia/serverless-express": "^4.12.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "pg": "^8.11.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
