{
  "name": "agrosbo",
  "version": "0.1.0",
  "private": true,
  "description": "AGROSBO - Plataforma web agrícola offline-first para gestionar operaciones de la granja (campo a acciones, historial y evidencia operativa)",
  "workspaces": [
    "web",
    "api",
    "infra",
    "shared",
    "spikes/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agrosbo/api",
    "dev:web": "npm run dev --workspace=@agrosbo/web",
    "dev:api": "npm run dev --workspace=@agrosbo/api",
    "dev:lovable": "npm run dev --workspace=@agrosbo/web -- --host 0.0.0.0 --port 8080",
    "build:dev": "cd web && VITE_USE_MOCKS=1 vite build --mode development && cd .. && rm -rf dist && cp -r web/dist/public dist",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:memstorage": "vitest run --config vitest.memstorage.config.ts",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "db:generate": "npm run db:generate --workspace=@agrosbo/api",
    "db:migrate": "npm run db:migrate --workspace=@agrosbo/api",
    "db:check": "npm run db:check --workspace=@agrosbo/api",
    "db:seed": "npm run db:seed --workspace=@agrosbo/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
