# AGROSBO - Variables de entorno (ejemplo)
# Copiar a .env.local y completar. NUNCA commitear .env.local ni secretos reales.
# Los valores aquí son sintéticos / de referencia.

# =====================================================================
# Aplicación (usadas por el código actual — api/src/env.ts)
# =====================================================================

# development | production | test
NODE_ENV=development

# Puerto del servidor Express (entero 1..65535)
PORT=5000

# Conexión PostgreSQL (node-postgres). Si se omite y no hay AWS_RDS_*,
# el backend usa almacenamiento en MEMORIA (subconjunto core, solo dev).
DATABASE_URL=postgres://agrosbo:CHANGE_ME@localhost:5432/agrosbo

# Forzar almacenamiento en memoria aunque exista DATABASE_URL (solo dev).
# 1|true|yes|on = activado. Nota: el modo memoria NO cubre adjuntos, finanzas,
# aplicaciones, apicultura ni usuarios (esos requieren PostgreSQL).
USE_MEM_STORAGE=0

# Aplicación de autenticación: on|off. Default off (dev, acceso abierto con
# usuario admin sintético). En producción DEBE ser on.
AUTH_ENFORCEMENT=off

# Secreto de firma de la cookie de sesión (>=16 chars). REQUERIDO si
# AUTH_ENFORCEMENT=on. En producción, gestionar con AWS Secrets Manager.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_use_a_long_random_value

# Contraseña del admin sembrado inicial (>=8 chars). Si se omite, se genera una
# aleatoria y se imprime UNA vez en los logs del servidor. Gestionar como secreto.
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# =====================================================================
# AWS RDS Data API (opcional; acceso a datos en Lambda — api/src/db.ts)
# Si los tres AWS_RDS_* están definidos, se usa Data API en lugar de DATABASE_URL.
# =====================================================================
AWS_REGION=us-east-1
AWS_RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:agrosbo-db-XXXXXX
AWS_RDS_RESOURCE_ARN=arn:aws:rds:us-east-1:000000000000:cluster:agrosbo-serverless
AWS_RDS_DATABASE=agrosbo

# =====================================================================
# Archivos / adjuntos (FUTURO — NO implementado todavía)
# Hoy los adjuntos se guardan en disco local (api/src/attachments.ts).
# Estas variables quedan reservadas para la migración a S3 (ADR 007 / Spec #8).
# El código actual NO las lee.
# =====================================================================
# local | s3   (actualmente siempre 'local', implícito)
ATTACHMENTS_STORAGE_DRIVER=local
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_PREFIX=attachments/

# =====================================================================
# Deferred experimental integrations (NO implementadas — histórico Spike C)
# Textract / Azure Document Intelligence pertenecían a la trazabilidad de café
# (ADR 005, Deferred). El código de la aplicación NO las usa. Se conservan aquí
# solo como referencia; no configurar salvo que una Spec futura las reactive.
# =====================================================================
# TEXTRACT_ENABLED=false
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=
# DOC_CONFIDENCE_THRESHOLD=0.85
