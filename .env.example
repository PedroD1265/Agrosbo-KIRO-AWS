# AGROSBO - Variables de entorno de laboratorio
# Copiar a .env.local y completar con valores reales.
# NUNCA commitear .env.local ni credenciales reales.

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=agrosbo-dev

# Aurora Data API (Spike A/B)
DB_CLUSTER_ARN=arn:aws:rds:us-east-1:ACCOUNT:cluster:agrosbo-dev-spike-db
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:agrosbo-dev-spike-db-creds
DB_NAME=agrosbo_spike

# S3 (Spike C)
S3_BUCKET=agrosbo-dev-spike-docs

# Textract
TEXTRACT_ENABLED=true

# Azure Document Intelligence (solo si disponible para Spike C)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Confidence threshold (configurable, lab default)
DOC_CONFIDENCE_THRESHOLD=0.85
