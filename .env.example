# AGROSBO - Variables de entorno (ejemplo)
# Copiar a .env.local y completar. NUNCA commitear .env.local ni secretos reales.
# Los valores aquí son sintéticos / de referencia.

# =====================================================================
# Core application (api/src/env.ts)
# =====================================================================

# development | production | test
NODE_ENV=development

# Puerto del servidor Express (entero 1..65535)
PORT=5000

# Conexión PostgreSQL (node-postgres). Si se omite y no hay AWS_RDS_*,
# el backend usa almacenamiento en MEMORIA (subconjunto core, solo dev).
DATABASE_URL=postgres://agrosbo:CHANGE_ME@localhost:5432/agrosbo

# Forzar almacenamiento en memoria aunque exista DATABASE_URL (solo dev).
USE_MEM_STORAGE=0

# =====================================================================
# Authentication
# =====================================================================

# Proveedor de identidad activo:
#   local-session  → cookie HMAC (solo dev/test; PROHIBIDO en producción)
#   cognito-jwt    → Amazon Cognito JWT (staging/producción)
APP_AUTH_PROVIDER=local-session

# Legacy toggle (respetado por el proveedor local-session).
# on = requiere sesión válida; off = acceso abierto con usuario demo.
AUTH_ENFORCEMENT=off

# Secreto de firma de la cookie (>=16 chars). Requerido si AUTH_ENFORCEMENT=on.
# En producción, gestionar con AWS Secrets Manager.
SESSION_SECRET=CHANGE_ME_use_a_long_random_value

# Contraseña del admin sembrado inicial (>=8 chars).
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# =====================================================================
# Amazon Cognito (requerido cuando APP_AUTH_PROVIDER=cognito-jwt)
# =====================================================================
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=

# =====================================================================
# AWS RDS Data API (acceso a datos en Lambda)
# Si los tres AWS_RDS_* están definidos, se usa Data API en lugar de DATABASE_URL.
# =====================================================================
AWS_REGION=us-east-1
AWS_RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:agrosbo-db-XXXXXX
AWS_RDS_RESOURCE_ARN=arn:aws:rds:us-east-1:000000000000:cluster:agrosbo-serverless
AWS_RDS_DATABASE=agrosbo

# =====================================================================
# Attachment storage
# =====================================================================

# Driver de almacenamiento de adjuntos:
#   local  → disco local (solo dev; PROHIBIDO en producción)
#   s3     → Amazon S3 con URLs prefirmadas (staging/producción)
ATTACHMENTS_STORAGE_DRIVER=local

# Requerido cuando ATTACHMENTS_STORAGE_DRIVER=s3
ATTACHMENTS_S3_BUCKET=

# =====================================================================
# Document extraction (NO implementado todavía — candidatos para benchmark)
# =====================================================================

# none | textract | azure
DOCUMENT_EXTRACTION_PROVIDER=none

# Amazon Textract
TEXTRACT_ENABLED=false

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# =====================================================================
# Frontend (variables VITE_* se incluyen en el bundle web)
# =====================================================================

# Base URL de la API. Vacío = mismo origen (dev local con proxy Vite).
# En despliegue cloud: URL pública de API Gateway o endpoint API definido por la arquitectura CloudFront (e.g. https://api.agrosbo.com)
VITE_API_BASE_URL=
